# ═══════════════════════════════════════
# BEAUTY ZONE — Environment Variables
# ═══════════════════════════════════════
# انسخ هذا الملف إلى server/.env وعدّل القيم

# Server
PORT=3001

# Security — غيّره لباسورد عشوائي قوي
JWT_SECRET=bz-secret-key-change-in-production-2026

# CORS — دومين الموقع (لما تنشر أونلاين)
ALLOWED_ORIGIN=http://localhost:3001

# Uploads
UPLOAD_DIR=./uploads